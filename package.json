{
  "name": "task-management-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "design:tokens": "design.md export DESIGN.md --format css-tailwind > app/design-tokens.generated.css",
    "predev": "npm run design:tokens",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "oxlint",
    "lint:design": "design.md lint DESIGN.md",
    "format": "oxfmt",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "lefthook install",
    "db:seed": "tsx app/db/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "postgres": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
